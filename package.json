{
  "name": "counterline-pos",
  "private": true,
  "version": "1.0.41",
  "description": "aptPOS retail billing and inventory desktop application",
  "author": "aptPOS",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('dist-electron',{recursive:true,force:true}); fs.rmSync('release',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "server:build": "node node_modules/esbuild/bin/esbuild server.ts --bundle --platform=node --format=esm --outfile=dist-electron/server.js --external:vite --external:sql.js --packages=external",
    "electron:compile": "node -e \"const fs=require('fs'); fs.rmSync('dist-electron',{recursive:true,force:true})\" && tsc --project tsconfig.electron.json && npm run server:build",
    "electron:dev": "concurrently -k -n SERVER,ELECTRON -c cyan,yellow \"tsx server.ts\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron dist-electron/main.js\"",
    "gen-assets": "node scripts/gen-installer-assets.cjs",
    "electron:build": "npm run gen-assets && npm run build && npm run electron:compile && electron-builder --win nsis --x64",
    "electron:preview": "npm run build && npm run electron:compile && electron dist-electron/main.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "jsbarcode": "^3.12.3",
    "pdf-to-printer": "^5.8.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resedit": "^1.7.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  }
}
